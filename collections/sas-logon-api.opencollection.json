{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAS Viya REST BusinessRules Logon API",
    "version": "2024.10"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "resource_owner_password_credentials",
      "accessTokenUrl": "/SASLogon/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Logon",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain OAuth Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{viya-host}/SASLogon/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "username",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Obtain OAuth Access Token"
        }
      ]
    }
  ],
  "bundled": true
}