{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAS Viya REST BusinessRules Jobs API",
    "version": "2024.10"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "resource_owner_password_credentials",
      "accessTokenUrl": "/SASLogon/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{viya-host}/jobExecution/jobs"
          },
          "docs": "List Jobs"
        },
        {
          "info": {
            "name": "Create Job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{viya-host}/jobExecution/jobs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Job"
        },
        {
          "info": {
            "name": "Get Job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{viya-host}/jobExecution/jobs/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Job"
        }
      ]
    }
  ],
  "bundled": true
}